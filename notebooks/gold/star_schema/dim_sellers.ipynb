    "CREATE OR REPLACE VIEW second_data_engineering_project.star_schema.dim_sellers\n",
    "AS\n",
    "SELECT \n",
    "    ROW_NUMBER() OVER (ORDER BY seller_id),\n",
    "    seller_id,\n",
    "    seller_zip_code_prefix,\n",
    "    seller_city,\n",
    "    seller_state\n",
    "FROM second_data_engineering_project.silver.sellers"
   ]
  }
